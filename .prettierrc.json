{
  "plugins": ["./web/node_modules/prettier-plugin-svelte/plugin.js"],
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "trailingComma": "all",
  "overrides": [
    { "files": "*.svelte", "options": { "parser": "svelte" } },
    { "files": "*.webmanifest", "options": { "parser": "json" } }
  ]
}
