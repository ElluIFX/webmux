{
  "name": "webmux-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write --ignore-path ../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../.prettierignore .",
    "dev": "vite --host 127.0.0.1",
    "test": "pnpm run test:unit && pnpm run test:browser && pnpm run test:e2e",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:report": "playwright show-report playwright-report"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "svelte": "^5.57.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tabler/icons-svelte": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.4",
    "bits-ui": "^2.19.5",
    "cn": "^0.4.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn-svelte": "^1.7.0",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^7.1.9",
    "vitest": "^5.0.4",
    "vitest-browser-svelte": "^3.1.0"
  }
}
